# ---------------------------------------------------------------------------
# Murgay Lead Intelligence — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://murgay:murgay@localhost:5432/murgay?schema=public"

# Unpooled connection for `prisma migrate`. On a single server this is the same
# value as DATABASE_URL; on serverless DATABASE_URL is the pooled URL and this
# is the direct one.
DIRECT_URL="postgresql://murgay:murgay@localhost:5432/murgay?schema=public"

# Secret used to sign session cookies and encrypt provider API keys at rest.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Credentials created by `npx prisma db seed` for the initial admin account.
ADMIN_EMAIL="admin@murgay.com"
ADMIN_PASSWORD="ChangeMe!2026"

# Set to "false" on a production deployment to seed the admin account and
# settings without the synthetic demo businesses.
SEED_DEMO_DATA="true"

# --- Business data provider -------------------------------------------------
# One of: mock | google-places
# `mock` requires no API key and makes the whole app usable offline.
BUSINESS_DATA_PROVIDER="mock"
BUSINESS_DATA_API_KEY=""

# --- Email finder -----------------------------------------------------------
# One of: mock | website-crawler
EMAIL_FINDER_PROVIDER="website-crawler"
EMAIL_FINDER_API_KEY=""

# --- Email verification -----------------------------------------------------
# One of: none | mock | syntax
# `none` reports "Verification unavailable" instead of guessing.
EMAIL_VERIFICATION_PROVIDER="none"
EMAIL_VERIFICATION_API_KEY=""

# --- Optional overrides -----------------------------------------------------
# Public origin, used for absolute URLs in server-side fetches.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
