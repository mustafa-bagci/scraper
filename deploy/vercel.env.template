# Murgay Lead Intelligence — Vercel environment
#
# 1. Replace the two database URLs below with your own.
# 2. Replace AUTH_SECRET with the output of:  openssl rand -base64 48
# 3. In Vercel: Settings -> Environment Variables -> Import .env
#    Tick Production (and Preview if you use it).
#
# Or skip the editing and let the script do it:
#   npm run vercel:env -- "<your Neon connection string>"
#
# These three are the only variables Vercel needs. Everything else has a
# working default. Do NOT add ADMIN_EMAIL / ADMIN_PASSWORD / SEED_DEMO_DATA —
# those belong to the seed command you run from your own machine. Provider API
# keys go in Settings -> Data Providers, where they are encrypted at rest.

# Pooled connection — Neon: "Connection pooling" ON (host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection — the same string without -pooler. Used by `prisma migrate`
# during the build; the running app never touches it.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies and encrypts stored provider API keys. Generate once
# and keep it: changing it logs everyone out and makes stored keys unreadable.
AUTH_SECRET="REPLACE_ME_WITH_openssl_rand_base64_48"
